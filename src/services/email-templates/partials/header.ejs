<tr>
  <td style="background: linear-gradient(135deg, <%= headerColor %> 0%, <%= headerColorEnd || headerColor %> 100%); padding: 48px 40px; text-align: center;">
    <div style="font-size: 48px; margin-bottom: 16px;"><%= icon %></div>
    <h1 style="color: #ffffff; margin: 0 0 8px 0; font-size: 32px; font-weight: 700;"><%= title %></h1>
    <p style="color: rgba(255,255,255,0.8); margin: 0; font-size: 18px;"><%= subtitle %></p>
  </td>
</tr>
